{
  "name": "eu5mapper-save-import",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build:presign && npm run build:jomini && npm run build:rakaly",
    "build:presign": "esbuild presign-lambda/handler.ts --bundle --platform=node --target=node22 --external:@aws-sdk/* --outfile=dist/presign-lambda/handler.js",
    "build:jomini": "esbuild jomini-lambda/handler.ts --bundle --platform=node --target=node22 --external:@aws-sdk/* --external:jomini --external:zod --alias:@shared=../shared --outfile=dist/jomini-lambda/handler.js",
    "build:rakaly": "esbuild rakaly-lambda/handler.ts --bundle --platform=node --target=node22 --external:@aws-sdk/* --outfile=rakaly-lambda/dist/handler.js",
    "test": "jest",
    "test:unit": "jest tests/presign.test.ts",
    "test:rakaly": "jest tests/rakaly.test.ts",
    "test:jomini": "jest tests/jomini.test.ts",
    "parse-savegame": "tsx parse-savegame-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "jomini": "^0.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "esbuild": "^0.19.12",
    "jest": "^29.7.0",
    "serverless": "^3.40.0",
    "serverless-iam-roles-per-function": "^3.2.0",
    "serverless-offline": "^13.9.0",
    "serverless-s3-local": "^0.8.5",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
