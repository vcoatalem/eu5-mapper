{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "paths": {
      "@shared/*": ["../shared/dist/*"]
    }
  },
  "references": [{ "path": "../shared/tsconfig.json" }],
  "include": [
    "*",
    "presign-lambda/**/*",
    "rakaly-lambda/**/*",
    "jomini-lambda/**/*",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "dist", "rakaly-lambda/dist"]
}
